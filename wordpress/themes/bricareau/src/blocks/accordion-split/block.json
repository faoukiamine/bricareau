{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bricareau/accordion-split",
	"title": "Accordéon avec image",
	"category": "bricareau",
	"icon": "list-view",
	"description": "Liste dépliable à côté d’une image, qui peut changer selon la ligne ouverte.",
	"supports": {
		"html": false,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"labelStyle": {
			"type": "string",
			"default": "pill"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"accentStyle": {
			"type": "string",
			"default": "green"
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"headerAlign": {
			"type": "string",
			"enum": [
				"center",
				"left"
			],
			"default": "left"
		},
		"headerBar": {
			"type": "boolean",
			"default": false
		},
		"image": {
			"type": "object",
			"default": {}
		},
		"imageSide": {
			"type": "string",
			"enum": [
				"left",
				"right"
			],
			"default": "right"
		},
		"items": {
			"type": "array",
			"default": []
		}
	},
	"textdomain": "bricareau",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}