{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bricareau/before-after",
	"title": "Avant / Après",
	"category": "bricareau",
	"icon": "image-flip-horizontal",
	"description": "Comparaisons avant/après en images.",
	"supports": {
		"html": false,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"labelStyle": {
			"type": "string",
			"default": "pill"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"accentStyle": {
			"type": "string",
			"default": "green"
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"headerAlign": {
			"type": "string",
			"enum": [
				"center",
				"left"
			],
			"default": "center"
		},
		"headerBar": {
			"type": "boolean",
			"default": false
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": [
				{
					"code": "",
					"color": "orange",
					"title": "",
					"subtitle": "",
					"before": {},
					"beforeCaption": "",
					"after": {},
					"afterCaption": ""
				}
			]
		}
	},
	"textdomain": "bricareau",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
