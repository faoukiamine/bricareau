{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bricareau/cta-band",
	"title": "Bandeau d’appel à l’action",
	"category": "bricareau",
	"icon": "megaphone",
	"description": "Bandeau bleu avec surtitre, titre, texte et deux boutons.",
	"supports": {
		"html": false,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"ctaText": {
			"type": "string",
			"default": ""
		},
		"ctaUrl": {
			"type": "string",
			"default": ""
		},
		"secondaryText": {
			"type": "string",
			"default": ""
		},
		"secondaryUrl": {
			"type": "string",
			"default": ""
		},
		"theme": {
			"type": "string",
			"enum": [
				"navy",
				"light"
			],
			"default": "navy"
		}
	},
	"textdomain": "bricareau",
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
