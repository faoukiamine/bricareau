{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bricareau/card-stack",
	"title": "Pile de cartes + avantages",
	"category": "bricareau",
	"icon": "images-alt2",
	"description": "Pile de photos qui tourne et liste d'avantages synchronisée.",
	"supports": {
		"html": false,
		"anchor": true
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		},
		"labelStyle": {
			"type": "string",
			"default": "pill"
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"accentStyle": {
			"type": "string",
			"default": "green"
		},
		"intro": {
			"type": "string",
			"default": ""
		},
		"headerAlign": {
			"type": "string",
			"enum": [
				"center",
				"left"
			],
			"default": "center"
		},
		"headerBar": {
			"type": "boolean",
			"default": false
		},
		"interval": {
			"type": "number",
			"default": 3
		},
		"items": {
			"type": "array",
			"default": [
				{
					"title": "",
					"text": "",
					"image": {}
				}
			]
		}
	},
	"textdomain": "bricareau",
	"editorScript": "file:./index.js",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
